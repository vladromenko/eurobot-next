ARG ROS_DISTRO=jazzy
FROM ros:${ROS_DISTRO}-ros-base
ARG ROS_DISTRO
SHELL ["/bin/bash", "-c"]
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake ninja-build python3-colcon-common-extensions ros-${ROS_DISTRO}-diagnostic-msgs ros-${ROS_DISTRO}-std-srvs ros-${ROS_DISTRO}-sensor-msgs ros-${ROS_DISTRO}-rclcpp-action ros-${ROS_DISTRO}-action-msgs ros-${ROS_DISTRO}-ament-cmake-pytest python3-pytest && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/eurobot-next
COPY firmware/include firmware/include
COPY firmware/src/core.cpp firmware/src/core.cpp
COPY ros2_ws ros2_ws
RUN bash ros2_ws/tools/build_ros2.sh --native --distro "${ROS_DISTRO}"
CMD ["bash", "-lc", "source /opt/ros/${ROS_DISTRO}/setup.bash && source /opt/eurobot-next/ros2_ws/install/${ROS_DISTRO}/setup.bash && exec ros2 launch eurobot_bringup robot.launch.xml"]
