# 2026 operations are primary. 2025 operations are explicitly secondary comparisons/fallbacks.
uint8 CURSOR=0
uint8 SIDE_GRIPS=1
uint8 ROTATE_MAIN=2
uint8 PUMPS=3
uint8 VALVES=4
uint8 BLOCKS_ROTATE=5
uint8 TIMED_MOVE=6
uint8 LIFT_HEIGHT=7
uint8 RELATIVE_MOVE=8
uint8 WHEEL_CALIBRATION=9
uint8 BLOCKS_SHIFT=10
uint8 BLOCKS_ROTATE_ONLY=11
uint8 RELATIVE_MOVE_POLL=12
uint8 SLIDE=13
uint8 LEGACY_2025_RESET=20
uint8 LEGACY_2025_CYCLE=21
uint8 CAPTURE=22
uint8 RELEASE=23
uint8 PREPARE=24
uint32 control_token
uint8 gripper
uint8 operation
# State or height/slide in mm. TIMED_MOVE: signed m/s or rad/s (yaw); relative move: dx m.
float32 value
# TIMED_MOVE: positive duration ms. Relative move: dy m. Otherwise zero.
float32 argument
# Relative move: positive max speed m/s. Otherwise zero.
float32 speed
# Gripper-local pump/valve mask, or motion axis/wheel index as documented; never GPIO.
uint32 mask
# Inclusive range 100..60000; measured by both host monotonic clock and STM32.
uint32 timeout_ms
---
uint8 EVIDENCE_UNKNOWN=0
uint8 EVIDENCE_COMMANDED=1
uint8 EVIDENCE_SETTLED=2
uint8 EVIDENCE_REFERENCED_STEPS=3
uint8 EVIDENCE_MEASURED=4
bool completed
# False after link/session loss or an unconfirmed cancellation; old feedback is not final proof.
bool outcome_known
bool physically_verified
uint8 error_code
uint8 stop_error
uint32 job_id
uint8 phase
uint8 completion_evidence
uint8 commanded_steps
uint8 settled_steps
uint8 referenced_steps
uint8 measured_steps
uint32 elapsed_ms
string message
---
uint8 IDLE=0
uint8 RUNNING=1
uint8 COMPLETED=2
uint8 CANCELLED=3
uint8 FAULTED=4
uint32 job_id
uint8 phase
uint8 operation
uint8 step
uint8 step_count
uint8 completion_evidence
uint8 commanded_steps
uint8 settled_steps
uint8 referenced_steps
uint8 measured_steps
uint32 elapsed_ms
# Fraction of plan steps, not an inferred position, pressure or successful physical grasp.
float32 progress
