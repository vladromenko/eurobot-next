set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(DEFINED ENV{ARM_TOOLCHAIN_BIN})
 set(_arm_hint "$ENV{ARM_TOOLCHAIN_BIN}")
endif()
if(APPLE AND NOT _arm_hint)
 file(GLOB _st_tools "/Applications/STM32CubeIDE.app/Contents/Eclipse/plugins/com.st.stm32cube.ide.mcu.externaltools.gnu-tools-for-stm32.*/tools/bin")
 if(_st_tools)
  list(GET _st_tools 0 _arm_hint)
 endif()
endif()
find_program(CMAKE_C_COMPILER arm-none-eabi-gcc HINTS "${_arm_hint}" REQUIRED)
find_program(CMAKE_CXX_COMPILER arm-none-eabi-g++ HINTS "${_arm_hint}" REQUIRED)
find_program(CMAKE_ASM_COMPILER arm-none-eabi-gcc HINTS "${_arm_hint}" REQUIRED)
find_program(CMAKE_OBJCOPY arm-none-eabi-objcopy HINTS "${_arm_hint}" REQUIRED)
find_program(CMAKE_SIZE arm-none-eabi-size HINTS "${_arm_hint}" REQUIRED)
set(_cpu "-mcpu=cortex-m4 -mthumb -mfpu=fpv4-sp-d16 -mfloat-abi=hard")
set(CMAKE_C_FLAGS_INIT "${_cpu} -ffunction-sections -fdata-sections")
set(CMAKE_CXX_FLAGS_INIT "${_cpu} -ffunction-sections -fdata-sections -fno-exceptions -fno-rtti -fno-threadsafe-statics -fno-use-cxa-atexit")
set(CMAKE_ASM_FLAGS_INIT "${_cpu}")
